{
  "name": "qprint",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx server.ts",
    "dev:next": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "NODE_ENV=production tsx server.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:use:postgres": "node -e \"require('fs').copyFileSync('prisma/schema.postgresql.prisma', 'prisma/schema.prisma'); console.log('Switched Prisma to PostgreSQL schema')\"",
    "db:use:sqlite": "node -e \"require('fs').copyFileSync('prisma/schema.sqlite.prisma', 'prisma/schema.prisma'); console.log('Switched Prisma to SQLite schema')\"",
    "lint": "eslint"
  },
  "dependencies": {
    "@prisma/client": "6.4.1",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "express": "^5.3.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "prisma": "6.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
